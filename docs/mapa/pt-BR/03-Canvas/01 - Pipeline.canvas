    },
    {
      "id": "893ce80729195afe",
      "type": "text",
      "text": "# Início\n`start()` → `_run_pipeline`",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "4"
    },
    {
      "id": "0b0088ea4af2070c",
      "type": "text",
      "text": "## Pré-checagens\nfonte, chaves, ffmpeg",
      "x": 400,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "3"
    },
    {
      "id": "a2843ebd03a7d7dd",
      "type": "text",
      "text": "# Falha\n`_mark_task_failed` grava `failed_stage`",
      "x": 400,
      "y": 200,
      "width": 320,
      "height": 140,
      "color": "1"
    },
    {
      "id": "ccdb3717dd1f8154",
      "type": "text",
      "text": "# 1 · Roteiro\nLLM, pulado com `video_script`",
      "x": 800,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "6f28133e9829d70f",
      "type": "text",
      "text": "# 2 · Termos\nLLM e rerank opcional",
      "x": 1200,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "a5ca0b5894324f8b",
      "type": "text",
      "text": "# 3 · Áudio\nTTS ou silêncio",
      "x": 1600,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "88f7b0199083ab4f",
      "type": "text",
      "text": "# 4 · Legenda\nedge ou whisper",
      "x": 2000,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "b0362266f4a485e9",
      "type": "text",
      "text": "# 5 · Materiais\nlocal ou provedor de vídeo",
      "x": 2400,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "421b47ffd946ca08",
      "type": "text",
      "text": "# 6 · Vídeo\ncombina, mixa, legenda, BGM",
      "x": 2800,
      "y": 0,
      "width": 320,
      "height": 140
    },
    {
      "id": "82f60b1d688c0223",
      "type": "text",
      "text": "# Concluído\n`state=1`; publicação em segundo plano",
      "x": 3200,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "6"
    },
    {
      "id": "7fad4cee9e5014d0",
      "type": "text",
      "text": "## stop_at\nesta é a etapa-alvo? sim: devolve; não: segue",
      "x": 800,
      "y": 200,
      "width": 320,
      "height": 140,
      "color": "3"
    },
    {
      "id": "f5cef96d7e57bb60",
