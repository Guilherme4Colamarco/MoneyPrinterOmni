      "height": 140,
      "color": "5"
    },
    {
      "id": "6f28133e9829d70f",
      "type": "text",
      "text": "# 2 · Terms\nLLM, optional rerank",
      "x": 1200,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "a5ca0b5894324f8b",
      "type": "text",
      "text": "# 3 · Audio\nTTS or silence",
      "x": 1600,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "88f7b0199083ab4f",
      "type": "text",
      "text": "# 4 · Subtitles\nedge or whisper",
      "x": 2000,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "b0362266f4a485e9",
      "type": "text",
      "text": "# 5 · Materials\nlocal or video provider",
      "x": 2400,
      "y": 0,
      "width": 320,
      "height": 140,
      "color": "5"
    },
    {
      "id": "421b47ffd946ca08",
      "type": "text",
      "text": "# 6 · Video\ncombine, mix, subtitles, BGM",
